# Datos crudos descargados de la SEC (reproducibles ejecutando el script).
# Excepción: SI commiteamos data/edgar.db (snapshot de la BBDD procesada) para
# que la app de Streamlit funcione en Community Cloud sin re-correr el pipeline.
# Nota: usamos `data/*` (no `data/`) para que la regla negativa de abajo funcione
# — git no permite re-incluir ficheros cuyo directorio padre esté excluido.
data/*
!data/edgar.db

# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Variables de entorno locales
.env
.env.local

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Build artefactos
build/
dist/
